# AWS / Bedrock configuration
# India: use AWS_REGION=ap-south-1 with apac.* inference-profile model IDs (see backend/.env).
AWS_REGION=us-east-1
BEDROCK_ROUTER_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_REASONING_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Execution & Mock Flags
MOCK_BEDROCK=false
MOCK_FETCH=false
PLAYWRIGHT_POOL_SIZE=2
ENABLE_PLAYWRIGHT=true
